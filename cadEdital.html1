              <a class="nav-link" href="#">Link</a>
            </li>
          </ul>
        </div> -->

    </nav>
<div class="text-center" style="background-color: #ffffff;">
            <img src="assets/img/logos.png" class="img-fluid " alt="">
        </div>
    <div class="container">

        

        <h3 class="text-center mt-3">Cadastro EDITAL Nº 01/2021/PPGCC/WEB, DE 13 DE DEZEMBRO DE 2021</h3>

        <hr>

        <div class="row">
            <div class="col">
                <p><b>Identificação</b></p>
                <p><input placeholder="Telefone só números" class="form-control" name="phone"></p>
                <p><input placeholder="Endereço" class="form-control" name="lname"></p>
                <p><input placeholder="Data de Nascimento dd/mm/yyyy" class="form-control" name="lname"></p>
                <br>
                <p class="text-right"><button type="submit" class="btn btn-primary">CADASTRAR</button></p>
            </div>

            <div class="col">

                                <p><b>Nome:</b> Frederico de Oliveira Tavares</p>
                                <p><b>Email:</b> frederico.tavares@ufac.br</p>
                                <p><b>Telefone:</b> 981009004</p>
                                <p><b>Endereço:</b> UFAC</p>
                                <p><b>Data Nascimento:</b> 12/12/2021</p>
                                <hr>
                                <p class="text-right"><button type="submit" class="btn btn-sm btn-success">EDITAR</button></p>

            </div>
        </div>

        <hr>

        <div class="row">
            <div class="col">
                <p><b>Documentos I</b></p>
                <label for="">Cópia de Documento de Identificação Oficial com Foto</label>
                <p><input type="file" class="form-control"></p>

                <label for="">Cópia do CPF (se não estiver contido no documento de identificação)</label>
                <p><input type="file" class="form-control"></p>
                <br>
                <p class="text-right"><button type="submit" class="btn btn-primary">CADASTRAR</button></p>
            </div>
            <div class="col">
                <div class="row">
                    <div class="col"><b>Documento Completo:</b> cnh.pdf </div>
                    <div class="col text-right"><button type="submit" class="btn btn-sm btn-danger">excluir</button></div>
                </div>
                <br>
                <div class="row">
                    <div class="col"><b>CPF:</b> </div>
                    <div class="col text-right"><button type="submit" class="btn btn-sm btn-danger">excluir</button></div>
                </div>
            </div>
        </div>
        <hr>

        <div class="row">
            <div class="col">
                <p><b>Documentos II</b></p>
                <label for="">Comprovante de matrícula em curso de graduação ou técnico dispostos no item 2.2.1 e que
                    atendam 2.2.2 ou certificado de conclusão/diploma no curso exigido como requisito mínimo</label>
                <p><input type="file" class="form-control"></p>

                <label for="">Termo de compromisso em formulário próprio, segundo modelo do ANEXO I</label>
                <p><input type="file" class="form-control"></p>

                <label for="">Cópia simples do histórico escolar dos cursos de graduação ou técnicos</label>
                <p><input type="file" class="form-control"></p>
                <br>
                <p class="text-right"><button type="submit" class="btn btn-primary">CADASTRAR</button></p>
            </div>
            <div class="col">
                <div class="row">
                    <div class="col"><b>Comprovante de matrícula:</b> </div>
                    <div class="col text-right"><button type="submit" class="btn btn-sm btn-danger">excluir</button></div>
                </div>
                <br>
                <div class="row">
                    <div class="col"><b>Termo de compromisso:</b> </div>
                    <div class="col text-right"><button type="submit" class="btn btn-sm btn-danger">excluir</button></div>
                </div>
                <br>
                <div class="row">
                    <div class="col"><b>Histórico escolar:</b> </div>
                    <div class="col text-right"><button type="submit" class="btn btn-sm btn-danger">excluir</button></div>
                </div>
            </div>
        </div>
        <hr>

        <div class="row">
            <div class="col">
                <p><b>Documentos III</b></p>
                <label for="">Para os candidatos de vagas reservadas ao sistema de cotas (enviar documentação de acordo
                    com a vaga que esteja se inscrevendo):</label>

                    <label for="">(I) Termo de autodeclaração de pretos, pardos e indígenas, conforme modelo do Anexo II do
                        Edital,   devidamente assinado.</label>
                    <p><input type="file" class="form-control"></p>
    
                    <label for="">(II) Termo de autodeclaração de baixa renda, conforme modelo do Anexo III do Edital,
                        devidamente assinado.</label>
                    <p><input type="file" class="form-control"></p>
                    <br>
                <p class="text-right"><button type="submit" class="btn btn-primary">CADASTRAR</button></p>

            </div>
            <div class="col">
                <div class="row">
                    <div class="col"><b>(I) Termo de autodeclaração de pretos:</b> </div>
                    <div class="col text-right"><button type="submit" class="btn btn-sm btn-danger">excluir</button></div>
                </div>
                <br>
                <div class="row">
                    <div class="col"><b>(II) Termo de autodeclaração de baixa renda:</b> </div>
                    <div class="col text-right"><button type="submit" class="btn btn-sm btn-danger">excluir</button></div>
                </div>
                <br>
            </div>
        </div>
        <hr>

    </div>

    <br><br>
<div class="text-center">
